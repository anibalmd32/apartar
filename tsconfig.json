{
    "compilerOptions": {
        /* Lenguaje y módulos */
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],

        /* Vite se encarga de emitir; aquí solo se comprueban tipos. */
        "noEmit": true,
        "allowJs": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,

        /* REQ-QAX-002 RB-3: estricto de verdad. `noUncheckedIndexedAccess`
           es el que obliga a tratar `array[i]` como posiblemente indefinido,
           que es de donde salen los fallos silenciosos en producción. */
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,

        "baseUrl": ".",
        "paths": {
            "@/*": ["./resources/js/*"],
            "ziggy-js": ["./vendor/tightenco/ziggy"]
        }
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "vitest.config.ts", "eslint.config.js"]
}
