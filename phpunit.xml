<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!-- El aislamiento multi-tenant tiene su propio job de CI
                 (REQ-QAX-004 RB-4b): su fallo tiene que ser inequívoco y no
                 quedar sepultado entre cientos de tests de negocio. -->
            <exclude>tests/Feature/Tenancy</exclude>
            <!-- Y la concurrencia tiene su propia ronda, en serie: ver abajo. -->
            <exclude>tests/Feature/Concurrency</exclude>
        </testsuite>
        <testsuite name="Tenancy">
            <directory>tests/Feature/Tenancy</directory>
        </testsuite>

        <!--
            T-003b · los tests que **no pueden correr en paralelo**.

            Todo lo demás corre en paralelo (`composer test:parallel`), que da
            a cada proceso su propia base de datos (`apartar_testing_test_1`,
            `_test_2`…).
            Estos no caben en ese esquema, y el motivo no es que sean lentos.
            Lo que tienen en común es que **confirman de verdad**: los de
            concurrencia por lo de abajo, y `CatalogFullTextSearchTest`
            (`T-034`) porque InnoDB solo indexa en `FULLTEXT` lo confirmado, y
            dentro de la transacción de `RefreshDatabase` todo `MATCH` da cero.
            Los de concurrencia, además:

              - **no pueden usar `RefreshDatabase`**, porque abren dos
                conexiones para provocar un bloqueo real y un bloqueo entre
                conexiones solo es observable sobre filas **confirmadas**;
              - al confirmar, limpian a mano lo que siembran, con un barrido
                por patrón (`concurrencia-…`);
              - y bajan `innodb_lock_wait_timeout` a un segundo en su sesión
                para convertir la espera en un error observable.

            Nada de eso convive con que otro proceso esté trabajando contra la
            misma base al mismo tiempo, y lo que produce **no es un fallo aquí
            sino en otro archivo**: intermitente, ajeno y carísimo de
            diagnosticar. Es lo que estaba detrás del `deadlock` al sembrar
            planes que se veía desde `T-030`.

            **Quien escriba el siguiente test de concurrencia lo pone en esta
            carpeta** —`T-044` tiene el de la reserva de la última unidad— y no
            tiene que acordarse: `ConcurrencyTestsAreIsolatedTest` recorre la
            suite y se pone rojo si aparece uno fuera.
        -->
        <testsuite name="Concurrency">
            <directory>tests/Feature/Concurrency</directory>
        </testsuite>
    </testsuites>

    <!--
        REQ-QAX-003 RB-1: el umbral de cobertura es del dominio, no global.
        Medir todo premiaría tests de relleno en las capas triviales; medir
        solo app/Domain y app/Actions obliga a cubrir donde está el dinero.
    -->
    <source>
        <include>
            <directory>app/Domain</directory>
            <directory>app/Actions</directory>
        </include>
    </source>

    <!--
        Cada variable va dos veces, y las dos hacen falta.

        Dentro del contenedor, docker-compose inyecta el `.env` como variables
        de entorno reales: sin `force="true"` PHPUnit las respetaría y la suite
        correría contra la base de datos de desarrollo. Y como el repositorio
        de entorno de Laravel consulta `$_SERVER` **antes** que `$_ENV`, ahí
        siguen estando los valores del contenedor aunque `putenv` ya lleve los
        de prueba; el `<server>` es el que gana esa carrera.

        El síntoma cuando falta uno de los dos no es un error claro: es la
        suite pasando contra el entorno equivocado.
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4"/>

        <!-- REQ-QAX-003 RB-8: MySQL real. El sistema depende de FULLTEXT, de
             lockForUpdate y de índices UNIQUE compuestos que SQLite no
             reproduce; probar sobre SQLite sería probar otro sistema.
             DB_HOST y DB_PORT los pone el entorno: `mysql:3306` dentro del
             compose, `127.0.0.1:3306` en el servicio de CI. -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="apartar_testing" force="true"/>
        <server name="DB_DATABASE" value="apartar_testing"/>

        <!-- REQ-QAX-003 SP-2: la zona se fija aquí para que ningún cálculo de
             vencimiento dependa de la del entorno que ejecute la suite. -->
        <env name="APP_TIMEZONE" value="America/Caracas" force="true"/>
        <server name="APP_TIMEZONE" value="America/Caracas"/>
        <env name="APP_LOCALE" value="es" force="true"/>
        <server name="APP_LOCALE" value="es"/>
        <env name="APP_FALLBACK_LOCALE" value="es" force="true"/>
        <server name="APP_FALLBACK_LOCALE" value="es"/>

        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array"/>
    </php>
</phpunit>
