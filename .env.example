APP_NAME=Apartar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_TIMEZONE=America/Caracas
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=apartar
DB_USERNAME=apartar
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_PRIORITIES=high,default,exports,telemetry

REVERB_APP_ID=apartar-local
REVERB_APP_KEY=apartar-local-key
REVERB_APP_SECRET=apartar-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/cuenta/google/callback

EXCHANGE_RATE_DRIVER=dolarapi
EXCHANGE_RATE_URL=https://ve.dolarapi.com/v1/dolares
EXCHANGE_RATE_TIMEOUT=8

DEEPSEEK_API_KEY=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@apartar.app"
MAIL_FROM_NAME="${APP_NAME}"

PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

PLATFORM_PAGO_MOVIL_BANK=
PLATFORM_PAGO_MOVIL_DETAIL=
PLATFORM_ZELLE_EMAIL=
PLATFORM_BINANCE_PAY_ID=

PLATFORM_MAX_OWNED_ORGANIZATIONS=1

VITE_APP_NAME="${APP_NAME}"
VITE_HOST=localhost

