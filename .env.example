# Apartar — plantilla de entorno (REQ-INF-004 RB-5).
#
# Copia este archivo a `.env` y rellena lo que está vacío. Las variables
# vacías a propósito son las credenciales externas: Google OAuth, VAPID y el
# superadmin de plataforma. `APP_KEY` la genera `php artisan key:generate`.
#
# Ningún secreto real se versiona (RB-8): lo que hay aquí son valores de
# ejemplo evidentes o los del entorno local dockerizado de 05 §9.2.
#
# Las líneas comentadas documentan variables que `config/` lee y que
# funcionan con su valor por defecto; descoméntalas solo para cambiarlo.

# --- Aplicación --------------------------------------------------------------
APP_NAME=Apartar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# REQ-INF-004 RB-2: toda fecha se persiste en UTC y se presenta en esta zona.
APP_TIMEZONE=America/Caracas
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# APP_PREVIOUS_KEYS=

BCRYPT_ROUNDS=12

# --- Autenticación -----------------------------------------------------------
# AUTH_GUARD=web
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_BROKER=users
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# AUTH_PASSWORD_TIMEOUT=10800

# --- Registro ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
# LOG_DEPRECATIONS_TRACE=false
# LOG_DAILY_DAYS=14

# --- Base de datos -----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=apartar
DB_USERNAME=apartar
DB_PASSWORD=secret
# Solo la usa docker-compose para inicializar el contenedor de MySQL.
DB_ROOT_PASSWORD=root
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_PREFIX=
# REDIS_PERSISTENT=false
# REDIS_TIMEOUT=60
# REDIS_CLUSTER=redis
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# REDIS_QUEUE=default
# REDIS_QUEUE_CONNECTION=default
# REDIS_QUEUE_RETRY_AFTER=90

# --- Drivers (REQ-INF-004 RB-1) ----------------------------------------------
# Los cinco son iguales en local y en producción a propósito: ni `database`
# para colas ni `file` para caché, para no descubrir divergencias al desplegar.
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# CACHE_PREFIX=
# QUEUE_FAILED_DRIVER=database-uuids

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción es obligatorio SESSION_SECURE_COOKIE=true (REQ-INF-004 RB-4).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# SESSION_COOKIE=apartar_session
# SESSION_CONNECTION=default
# SESSION_STORE=
# SESSION_TABLE=sessions
# SESSION_EXPIRE_ON_CLOSE=false
# SESSION_HTTP_ONLY=true
# SESSION_PARTITIONED_COOKIE=false

# --- Colas (REQ-INF-003) -----------------------------------------------------
# El orden de prioridad es estricto: high > default > exports > telemetry.
# Vive en config/queue.php y en el comando del servicio `queue` del compose.
QUEUE_PRIORITIES=high,default,exports,telemetry

# --- Reverb / WebSocket (REQ-INF-005) ----------------------------------------
# Asimetría deliberada: REVERB_HOST/PORT son los INTERNOS con los que PHP
# difunde hacia el contenedor; VITE_REVERB_* son los PÚBLICOS con los que el
# navegador del host conecta (REQ-INF-005 RB-2 y RB-3). Confundirlos deja el
# WebSocket muerto sin error visible.
REVERB_APP_ID=apartar-local
REVERB_APP_KEY=apartar-local-key
REVERB_APP_SECRET=apartar-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# REVERB_SERVER=reverb
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080
# REVERB_SERVER_PATH=
# REVERB_MAX_REQUEST_SIZE=10000
# REVERB_SCALING_ENABLED=false
# REVERB_SCALING_CHANNEL=reverb
# REVERB_APP_PING_INTERVAL=60
# REVERB_APP_ACTIVITY_TIMEOUT=30
# REVERB_APP_MAX_MESSAGE_SIZE=10000
# REVERB_APP_MAX_CONNECTIONS=
# REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=
# REVERB_APP_RATE_LIMITING_ENABLED=true
# REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
# REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
# REVERB_APP_RATE_LIMIT_TERMINATE=false

# --- Web Push / VAPID (REQ-NOT-001) ------------------------------------------
# Genéralas con `php artisan webpush:vapid` antes de T-082. Vacías, el push
# queda inactivo y el resto de la aplicación funciona igual.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="${APP_URL}"
# VAPID_PEM_FILE=
# WEBPUSH_AUTOMATIC_PADDING=true
# WEBPUSH_DB_CONNECTION=
# WEBPUSH_DB_TABLE=push_subscriptions

# --- Google OAuth de las cuentas de consumidor (REQ-ACC-001) -----------------
# Créalas en Google Cloud Console antes de T-073. Vacías, el acceso con
# Google no funciona; navegar y apartar siguen sin exigir cuenta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/cuenta/google/callback

# --- Tasa de cambio (REQ-FX-002) ---------------------------------------------
EXCHANGE_RATE_DRIVER=dolarapi
EXCHANGE_RATE_URL=https://ve.dolarapi.com/v1/dolares
EXCHANGE_RATE_TIMEOUT=8

# --- Correo ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@apartar.store"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_EHLO_DOMAIN=
# MAIL_LOG_CHANNEL=

# --- Superadmin de plataforma (REQ-PLT-001) ----------------------------------
# Semilla del primer PlatformUser. Vacías, PlatformAdminSeeder no siembra.
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- Medialibrary e importación/exportación ----------------------------------
# MEDIA_DISK=local
# MEDIA_CONVERSIONS_DISK=
# MEDIA_PREFIX=
# MEDIA_QUEUE=
# MEDIA_DOWNLOADER_SSL=true
# MEDIA_TEMPORARY_URL_DEFAULT_LIFETIME=5
# FORCE_MEDIA_LIBRARY_LAZY_LOADING=false
# IMAGE_DRIVER=gd
# QUEUE_CONVERSIONS_BY_DEFAULT=true
# QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true
# EXCEL_CACHE_DRIVER=memory
# EXCEL_CACHE_BATCH_MEMORY=60000
# EXCEL_CACHE_STORAGE=
# EXCEL_CHUNK_SIZE=1000

# --- Auditoría (REQ-BOF-005) -------------------------------------------------
# ACTIVITY_LOGGER_ENABLED=true
# ACTIVITY_LOGGER_DB_CONNECTION=
# ACTIVITY_LOGGER_TABLE_NAME=activity_log

# --- Vite --------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
# Host que anuncia el HMR al navegador del host (REQ-INF-004 SP-5).
VITE_HOST=localhost
