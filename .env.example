# Monitor (monitor.apartar.app): Pulse, Telescope y logs detrás de MONITOR_TOKEN (mínimo 32 caracteres).
MONITOR_DOMAIN=
MONITOR_TOKEN=
TELESCOPE_SAMPLE_PERCENT=10

# Laravel Pulse: los valores por defecto sirven; cambia solo si hace falta.
# PULSE_DOMAIN=
# PULSE_PATH=pulse
