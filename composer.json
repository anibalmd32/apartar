{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "apartar/apartar",
    "type": "project",
    "description": "Apartar — SaaS multi-tenant de catálogos con apartado.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "8.4.27",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel-notification-channels/webpush": "^13.0",
        "laravel/ai": "^1.3",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.11",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "^4.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-medialibrary": "^11.23",
        "symfony/html-sanitizer": "^7.3",
        "tightenco/ziggy": "^2.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -k -c \"#93c5fd,#c4b5fd,#fdba74,#86efac,#fb7185\" -n server,queue,schedule,reverb,vite \"php artisan serve\" \"php artisan queue:work --queue=high,default,exports,telemetry --tries=3\" \"php artisan schedule:work\" \"php artisan reverb:start --port=8082\" \"npm run dev\""
        ],
        "lint": [
            "@php vendor/bin/pint --test --cache-file=storage/framework/pint.cache"
        ],
        "lint:fix": [
            "@php vendor/bin/pint --cache-file=storage/framework/pint.cache"
        ],
        "analyse": [
            "@php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress"
        ],
        "test:quality": [
            "@php vendor/bin/pest tests/Feature/Quality"
        ],
        "test:parallel": [
            "@putenv LARAVEL_PARALLEL_TESTING=1",
            "@php vendor/bin/pest --parallel --testsuite=Unit,Feature,Tenancy"
        ],
        "test:concurrency": [
            "@php vendor/bin/pest --testsuite=Concurrency"
        ],
        "test": [
            "@test:parallel",
            "@test:concurrency"
        ],
        "test:coverage": [
            "@putenv LARAVEL_PARALLEL_TESTING=1",
            "@php -d pcov.enabled=1 vendor/bin/pest --parallel --testsuite=Unit,Feature,Tenancy --coverage --min=85 --passthru-php=\"'-d' 'pcov.enabled=1'\"",
            "@test:concurrency"
        ],
        "tenancy:audit": [
            "@php artisan tenancy:audit"
        ],
        "tenancy:suite": [
            "@putenv LARAVEL_PARALLEL_TESTING=1",
            "@php vendor/bin/pest --parallel --processes=4 --testsuite=Tenancy"
        ],
        "tenancy": [
            "@tenancy:audit",
            "@tenancy:suite"
        ],
        "check:steps": [
            "@lint",
            "@analyse",
            "@test:coverage"
        ],
        "check": [
            "@php scripts/check.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 0,
        "platform": {
            "php": "8.4.27"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts-descriptions": {
        "lint": "Pint en modo comprobación",
        "lint:fix": "Pint aplicando los arreglos",
        "analyse": "PHPStan/Larastan nivel 6",
        "test": "Suite completa: la ronda paralela y despues la de concurrencia, en serie",
        "test:quality": "Solo tests/Feature/Quality: reglas estructurales. El gate mas barato, y el paso ANTES de check",
        "test:parallel": "Unit + Feature + Tenancy en paralelo, una base de datos por proceso",
        "test:concurrency": "Los tests que NO pueden correr en paralelo, en serie (tests/Feature/Concurrency)",
        "test:coverage": "Igual que test, con el umbral de cobertura del dominio",
        "tenancy:audit": "Auditoria estatica del aislamiento: las cinco comprobaciones",
        "tenancy:suite": "Suite de fuga cruzada (tests/Feature/Tenancy), en paralelo con 4 procesos",
        "tenancy": "Gate de aislamiento multi-tenant completo: auditoria estatica + suite",
        "check:steps": "El orden de los gates, del mas barato al mas caro. Se lee aqui y se edita aqui. Delante va test:quality, a mano",
        "check": "check:steps con el cerrojo puesto: no arranca si npm run check esta corriendo"
    }
}
