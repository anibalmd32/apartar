{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "apartar/apartar",
    "type": "project",
    "description": "Apartar — SaaS multi-tenant de catálogos con apartado.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel-notification-channels/webpush": "^13.0",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.11",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "^4.0",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-medialibrary": "^11.23",
        "tightenco/ziggy": "^2.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "lint:fix": [
            "@php vendor/bin/pint"
        ],
        "analyse": [
            "@php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress"
        ],
        "test": [
            "@php vendor/bin/pest"
        ],
        "test:coverage": [
            "@php -d pcov.enabled=1 vendor/bin/pest --coverage --min=85"
        ],
        "tenancy": [
            "@php vendor/bin/pest --testsuite=Tenancy"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts-descriptions": {
        "lint": "Pint en modo comprobación (REQ-QAX-001 RB-7)",
        "lint:fix": "Pint aplicando los arreglos",
        "analyse": "PHPStan/Larastan nivel 6 (REQ-QAX-001 RB-6)",
        "test": "Suite de Pest completa",
        "test:coverage": "Pest con el umbral de cobertura del dominio (REQ-QAX-003 RB-1)",
        "tenancy": "Gate de aislamiento multi-tenant. Hoy solo la mitad estatica de REQ-QAX-008; T-007 anade `artisan tenancy:audit` y las cuatro suites de fuga cruzada.",
        "check": "lint + analyse + test"
    }
}
